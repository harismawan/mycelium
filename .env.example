# Production values (set real secrets before deploy)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/mycelium?schema=public
JWT_SECRET=<generate-128-hex-or-long-random-string>
MYCELIUM_API_KEY=<generate-random-api-key>
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173

# Optional semantic-search / embedding arm (feature-flagged OFF when unset)
# Set EMBEDDING_PROVIDER to enable vector search; leave unset for lexical-only mode.
EMBEDDING_PROVIDER=
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=<your-openai-api-key>
EMBEDDING_MODEL=text-embedding-3-small

# OpenTelemetry -> Elastic APM. Flip OTEL_ENABLED to "true" to start exporting.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.100.31:8200
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=always_on
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_LOG_LEVEL=error
OTEL_DEPLOYMENT_ENVIRONMENT=development
# OTLP Authorization header for Elastic APM. URL-encode the space after Bearer.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20REPLACE_ME
LOG_BODY=false
