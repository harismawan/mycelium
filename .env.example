# Production values (set real secrets before deploy)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/mycelium?schema=public
JWT_SECRET=<generate-128-hex-or-long-random-string>
MYCELIUM_API_KEY=<generate-random-api-key>
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173

# Optional semantic-search / embedding arm (feature-flagged OFF when unset)
# Set EMBEDDING_PROVIDER to enable vector search; leave unset for lexical-only mode.
EMBEDDING_PROVIDER=
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=<your-openai-api-key>
EMBEDDING_MODEL=text-embedding-3-small
