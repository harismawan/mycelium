# API Server Environment Variables
# The runtime .env lives at the repo root. Keep DATABASE_URL and OTEL_* config in ../../.env.example.
DATABASE_URL=postgresql://mycelium:mycelium@localhost:5432/mycelium?schema=public
JWT_SECRET=mycelium-dev-secret-change-in-production
REDIS_URL=redis://localhost:6379
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Semantic search (optional). Leave EMBEDDING_PROVIDER unset/empty to disable
# the vector arm — search then behaves exactly like lexical-only full-text.
EMBEDDING_PROVIDER=
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Operator note — before enabling the embedding arm:
# When EMBEDDING_PROVIDER is set, get_context uses hybrid RRF ranking instead
# of the importance-boost + last-access-decay path; the result shape on that
# path does NOT include score/snippet/source/confidence/importance fields.
# Notes created via save_memories (batch) are NOT embedded inline — run
# scripts/backfill-embeddings.js to embed pre-existing and batch-created notes.
