{
  "name": "@mycelium/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./services/*.js": "./src/services/*.js"
  },
  "scripts": {
    "dev": "bun --watch src/index.js",
    "start": "bun src/index.js",
    "test": "bun test --isolate",
    "db:migrate": "bunx prisma migrate dev",
    "db:migrate:deploy": "bunx prisma migrate deploy",
    "db:seed": "bunx prisma db seed",
    "db:reset": "bunx prisma migrate reset --force && bunx prisma db seed",
    "db:studio": "bunx prisma studio",
    "generate": "bunx prisma generate"
  },
  "prisma": {
    "seed": "bun prisma/seed.js"
  },
  "devDependencies": {
    "prisma": "^7"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@mycelium/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7",
    "bcryptjs": "^3.0.3",
    "elysia": "^1.4.28",
    "jsonwebtoken": "^9.0.3"
  }
}
