# MCP Server Environment Variables
DATABASE_URL=postgresql://mycelium:mycelium@localhost:5432/mycelium?schema=public
MYCELIUM_API_KEY=myc_demo_agent_key_for_testing
REDIS_URL=redis://localhost:6379
MCP_TRANSPORT=stdio
MCP_PORT=3001
NODE_ENV=development

# Semantic search (optional). Leave EMBEDDING_PROVIDER unset/empty to disable
# the vector arm — search then behaves exactly like lexical-only full-text.
EMBEDDING_PROVIDER=
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
